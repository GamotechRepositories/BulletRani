# ── Server ──────────────────────────────────────────────
SERVER_PORT=5000
SOCKET_HOST=0.0.0.0
SOCKET_PORT=5001

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_DAYS=7

# ── MongoDB (primary store — store.json is no longer used) ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=bullet_rani

# ── Provider Game SDK (dpbossking) ──────────────────────
PROVIDER_ENABLED=true
PROVIDER_API_URL=https://api.dpbossking.com/api/v1
GAME_SERVER_API_KEY=your-long-random-secret
PROVIDER_TABLE_ID=rikshawx_main
PROVIDER_GAME_CODE=RIKSHAWX
