# Copy to .env and adjust

# Local / LAN — must include /api (admin paths are /api/auth, /api/admin, …)
VITE_API_BASE=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5001

# Production (Vercel etc.): set these in the host dashboard to your HTTPS backend.
# Vite bakes them in at build time. Use https:// only (Socket.IO → wss automatically).
# Example:
# VITE_API_BASE=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
