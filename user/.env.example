# Copy to .env and adjust

# Local / LAN
VITE_API_BASE=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5001
VITE_PROVIDER_API_URL=https://api.dpbossking.com/api/v1

# Production (Vercel etc.): set these in the host dashboard to your HTTPS backend.
# Vite bakes them in at build time. Do not use http:// or ws:// — the browser blocks Mixed Content.
# Example:
# VITE_API_BASE=https://api.yourdomain.com
# VITE_SOCKET_URL=https://api.yourdomain.com
# (Socket.IO uses wss:// automatically when the page/base URL is https)
